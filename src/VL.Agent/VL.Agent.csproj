<Project Sdk="Microsoft.NET.Sdk">

  <!--
    vvvv-loaded HDE bridge. Package references make Release builds reproducible
    without requiring a local vvvv installation on the build machine.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <OutputPath Condition="'$(Configuration)' == 'Release'">..\..\lib\net8.0-windows7.0\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="VL.Core" Version="2025.7.2" PrivateAssets="all" Aliases="global,VLCore" />
    <PackageReference Include="VL.AppServices" Version="2025.7.2" PrivateAssets="all" />
    <PackageReference Include="VL.HDE" Version="2025.7.2" PrivateAssets="all" />
  </ItemGroup>

  <!-- VL.HDE's NuGet assumes the matching vvvv host supplies VL.Lang. -->
  <!-- CI sets VvvvInstallDir from the official portable 7.2 distribution. -->
  <ItemGroup Condition="'$(VvvvInstallDir)' != ''">
    <Reference Include="VL.Lang">
      <HintPath>$(VvvvInstallDir)\VL.Lang.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="RequireVvvvReferenceAssemblies" BeforeTargets="ResolveReferences"
          Condition="'$(VvvvInstallDir)' == '' Or !Exists('$(VvvvInstallDir)\VL.Lang.dll')">
    <Error Text="Set VvvvInstallDir to a vvvv gamma 7.2 directory containing VL.Lang.dll." />
  </Target>

</Project>
